<?xml version="1.0" encoding="utf-8"?>
<s:Module xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark" 
		  xmlns:mx="library://ns.adobe.com/flex/mx" width="100%" height="100%">
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.controls.Alert;
			import mx.rpc.events.FaultEvent;
			import mx.rpc.events.ResultEvent;
			
			protected function btPesquisar_clickHandler(event:MouseEvent):void
			{
				var codigo:String = EdtCodigo.text;
				var nome:String = EdtNome.text;
				
				sistemaServiceRO.getList(codigo, nome);
			}
			
			protected function onGetListResult(event:ResultEvent):void
			{
				var listaDeSistemas:ArrayCollection = event.result as ArrayCollection;
				
				dgAgente.dataProvider = listaDeSistemas;
			}
			
			protected function onFaultHandler(event:FaultEvent):void
			{
				Alert.show("Ocorreu um erro ao comunicar com o servidor: " + event.fault.faultString, "Erro");
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<s:RemoteObject id="sistemaServiceRO" destination="sistemaService"
						fault="onFaultHandler(event)">
			
			<s:method name="getList" result="onGetListResult(event)"/>
			
		</s:RemoteObject>
	</fx:Declarations>
	<s:Panel x="0" y="0" width="100%" height="100%" title="Lista de Sistemas">
		<s:BorderContainer left="10" right="10" top="23" height="96">
			<s:Button id="btPesquisar" right="10" bottom="10" height="21" label="Pesquisar"
					  click="btPesquisar_clickHandler(event)"/>
			<s:Label x="10" y="10" fontWeight="bold" text="Código"/>
			<s:Label x="246" y="10" fontWeight="bold" text="Nome"/>
			<s:TextInput id="EdtCodigo" y="30" left="10" width="100"/>
			<s:TextInput id="EdtNome" y="30" left="245" right="10"/>
			<s:Label x="118" y="10" fontWeight="bold" text="Status"/>
			<s:TextInput id="EdtStatus" x="118" y="30" width="120"/>
		</s:BorderContainer>
		<s:DataGrid id="dgAgente" left="10" right="10" top="160" bottom="10" requestedRowCount="4">
			<s:columns>
				<s:ArrayList>
					<s:GridColumn width="100" dataField="dataField1" headerText="Codigo"></s:GridColumn>
					<s:GridColumn dataField="dataField2" headerText="Nome"></s:GridColumn>
					<s:GridColumn width="300" dataField="dataField1" headerText="Status"></s:GridColumn>
				</s:ArrayList>
			</s:columns>
		</s:DataGrid>
		<s:Button id="btCriar" y="131" right="10" width="50" label="+"/>
		<s:Label y="140" left="10" fontSize="12" fontStyle="italic" fontWeight="bold" text="Lista"/>
		<s:Label x="11" y="6" fontSize="12" fontStyle="italic" fontWeight="bold" text="Pesquisar"/>
	</s:Panel>
</s:Module>

